# ==============================================================================
# KEMKENDRA B2B MARKETPLACE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit real credentials or secrets to version control.
# Copy this file to .env and provide secure, environment-specific values.
# ==============================================================================

# ==============================================================================
# 1. REQUIRED PRODUCTION SECRETS & PARAMETERS
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL) ---
# On Render: Use Internal Database URL or individual connection parameters
DB_URL=jdbc:postgresql://postgres:5432/kemkendra
DB_USER=kemkendra_admin
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# --- JWT SECURITY ---
# Minimum 256-bit (32-character) cryptographically secure random secret for HS256
JWT_SECRET=YOUR_MINIMUM_32_CHAR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_HERE
JWT_EXPIRATION=86400000

# --- BASE URLS & CORS ---
# Set APP_BASE_URL to your production frontend URL (e.g., https://kemkendra-frontend.onrender.com or custom domain)
APP_BASE_URL=https://kemkendra-frontend.onrender.com
# Comma-separated list of allowed browser origins for CORS preflight
CORS_ALLOWED_ORIGINS=https://kemkendra-frontend.onrender.com

# --- ENVIRONMENT SELECTION ---
SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# 2. OPTIONAL CONFIGURATION & TUNING
# ==============================================================================

# --- CONTAINER MEMORY PROFILE ---
# Conservative heap for container environments (e.g. Render 512MB RAM instance)
JAVA_TOOL_OPTIONS=-Xms96m -Xmx256m -XX:+ExitOnOutOfMemoryError

# --- INITIAL ADMIN BOOTSTRAP (Enable ONLY during first boot, then disable) ---
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@kemkendra.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_BOOTSTRAP_PASSWORD_HERE

# --- RATE LIMITING OVERRIDES (Requests per 60s per IP) ---
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRATION=10
RATE_LIMIT_PASSWORD_RESET=10
RATE_LIMIT_EMAIL_VERIFICATION=15
RATE_LIMIT_PUBLIC_API=120

# ==============================================================================
# 3. FRONTEND RUNTIME & BUILD CONFIGURATION (Next.js)
# ==============================================================================

# Production Backend URL accessible by the browser / server
NEXT_PUBLIC_API_URL=https://kemkendra-backend.onrender.com
NEXT_PUBLIC_SITE_URL=https://kemkendra-frontend.onrender.com
INTERNAL_API_URL=https://kemkendra-backend.onrender.com
BACKEND_API_URL=https://kemkendra-backend.onrender.com

# ==============================================================================
# 4. FUTURE / OPTIONAL: TRANSACTIONAL EMAIL (JavaMailSender)
# ==============================================================================
# Set MAIL_ENABLED=false until custom domain & SMTP credentials (Resend/SendGrid/SES) are verified
MAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=YOUR_SMTP_API_KEY_OR_PASSWORD_HERE
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_CONNECTION_TIMEOUT=5000
SMTP_TIMEOUT=5000
SMTP_WRITE_TIMEOUT=5000
MAIL_FROM=notifications@kemkendra.com
MAIL_FROM_NAME=KemKendra Chemical Marketplace
