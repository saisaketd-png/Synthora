# ==============================================================================
# SYNTHORA B2B MARKETPLACE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit real credentials or secrets to version control.
# Copy this file to .env and provide secure, environment-specific values.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
POSTGRES_DB=synthora
POSTGRES_USER=synthora_admin
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# --- SPRING BOOT BACKEND ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://postgres:5432/synthora
DB_USER=synthora_admin
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# --- JWT SECURITY ---
# Minimum 256-bit (32-character) cryptographically secure random string for HS256
JWT_SECRET=YOUR_MINIMUM_32_CHAR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_HERE
JWT_EXPIRATION=86400000

# --- INITIAL ADMIN BOOTSTRAP (Set to false after first deployment) ---
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@synthora.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# --- CORS & BASE URLS ---
SYNTHORA_CORS_ALLOWED_ORIGINS=https://synthora.com,https://www.synthora.com
APP_BASE_URL=https://synthora.com

# --- SMTP / EMAIL NOTIFICATIONS ---
MAIL_ENABLED=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY_OR_PASSWORD_HERE
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=notifications@synthora.com
MAIL_FROM_NAME=Synthora B2B Marketplace

# --- NEXT.JS FRONTEND ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://synthora.com
INTERNAL_API_URL=http://backend:8085
BACKEND_API_URL=http://backend:8085


